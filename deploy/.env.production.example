# MiniDash Endado — produccion (VPS de laburo)
# Copiar a deploy/.env (ignorado por git) y completar.

# --- Postgres (DB endado existente en el mismo VPS) ---
DB_HOST=postgres_postgres
DB_PORT=5432
DB_NAME=endado
DB_USER=postgres
DB_PASSWORD=

# --- JWT ---
JWT_SECRET=
JWT_EXP_DAYS=7
ALLOWED_EMAILS=toolsintartion@gmail.com

# --- Google Sign-In ---
GOOGLE_CLIENT_ID=

# --- Cache ---
CACHE_TTL_SECONDS=86400
INTERNAL_SECRET=

# --- CORS (dominio exacto del front en Render) ---
FRONTEND_ORIGIN=https://minidash.facundo.click
